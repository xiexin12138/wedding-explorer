generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

/// 系统设置表 - 用于存储系统级别的配置项
model SystemSetting {
  /// 设置项唯一标识符
  id          String           @id @default(cuid())
  /// 设置项键名（唯一）
  key         String           @unique @db.VarChar(100)
  /// 设置项显示名称
  displayName String           @db.VarChar(200)
  /// 设置项值
  value       String?          @db.Text
  /// 设置项类型：string, number, boolean, json, array
  valueType   SettingValueType @default(STRING)
  /// 设置项分类
  category    SettingCategory
  /// 设置项描述
  description String?          @db.Text
  /// 是否为系统内置设置（内置设置不可删除）
  isSystem    Boolean          @default(false)
  /// 是否启用
  isEnabled   Boolean          @default(true)
  /// 排序权重
  sortOrder   Int              @default(0)
  /// 创建时间
  createdAt   DateTime         @default(now())
  /// 更新时间
  updatedAt   DateTime         @updatedAt
  /// 创建者ID
  createdBy   String?          @db.VarChar(50)
  /// 更新者ID
  updatedBy   String?          @db.VarChar(50)

  @@index([category])
  @@index([isEnabled])
  @@index([sortOrder])
  @@map("system_settings")
}

model ActivityTimeline {
  id          String    @id @default(cuid())
  title       String
  description String?
  startTime   DateTime?
  endTime     DateTime?
  type        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// 用户信息表
model User {
  /// 用户唯一标识符（UUID）
  id               String                @id @default(cuid())
  /// 用户邮箱
  email            String?               @db.VarChar(255)
  /// 用户昵称
  nickname         String?               @db.VarChar(100)
  /// 用户真实姓名
  name             String?               @db.VarChar(100)
  /// 用户头像
  avatar           String?               @db.Text
  /// 用户角色
  role             UserRole              @default(GUEST)
  /// 是否启用
  isActive         Boolean               @default(true)
  /// 最后登录时间
  lastLoginAt      DateTime?
  /// 游戏币余额
  coins            Int                   @default(0)
  /// 累计获得游戏币总数
  totalCoinsEarned Int                   @default(0)
  /// 累计消费游戏币总数
  totalCoinsSpent  Int                   @default(0)
  /// 创建时间
  createdAt        DateTime              @default(now())
  /// 更新时间
  updatedAt        DateTime              @updatedAt
  authingUser      AuthingUser?
  wechatUser       WechatUser?
  prizeExchanges   PrizeExchangeRecord[]
  coinTransactions CoinTransaction[]
  attractionCheckIns UserAttractionCheckIn[]

  @@index([email])
  @@index([role])
  @@index([coins])
  @@index([totalCoinsEarned])
  @@index([isActive])
  @@map("users")
}

/// Authing 用户关联表
model AuthingUser {
  /// 主键
  id        String   @id @default(cuid())
  /// 关联的用户 ID
  userId    String   @unique
  /// Authing 用户 ID
  authingId String   @unique @db.VarChar(100)
  /// 创建时间
  createdAt DateTime @default(now())
  /// 更新时间
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([authingId])
  @@index([userId])
  @@map("authing_users")
}

/// 微信用户关联表
model WechatUser {
  /// 主键
  id        String   @id @default(cuid())
  /// 关联的用户 ID
  userId    String   @unique
  /// 微信 OpenID
  openId    String   @unique @db.VarChar(100)
  /// 微信 UnionID
  unionId   String?  @unique @db.VarChar(100)
  /// 创建时间
  createdAt DateTime @default(now())
  /// 更新时间
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([openId])
  @@index([unionId])
  @@index([userId])
  @@map("wechat_users")
}

/// 兑奖记录表
model PrizeExchangeRecord {
  /// 记录唯一标识符
  id                String         @id @default(cuid())
  /// 用户ID
  userId            String
  /// 奖品名称
  prizeName         String         @db.VarChar(200)
  /// 奖品描述
  prizeDesc         String?        @db.Text
  /// 消耗游戏币数量
  coinsSpent        Int
  /// 兑换时用户的游戏币余额（快照）
  userCoinsSnapshot Int
  /// 兑换状态
  status            ExchangeStatus @default(PENDING)
  /// 备注信息（如发货信息、领取方式等）
  remarks           String?        @db.Text
  /// 兑换时间
  exchangedAt       DateTime       @default(now())
  /// 处理时间（如发货、完成时间）
  processedAt       DateTime?
  /// 处理人ID
  processedBy       String?        @db.VarChar(100)
  /// 创建时间
  createdAt         DateTime       @default(now())
  /// 更新时间
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([exchangedAt])
  @@map("prize_exchange_records")
}

/// 游戏币流水记录表（用于追踪所有游戏币变动）
model CoinTransaction {
  /// 记录唯一标识符
  id                String          @id @default(cuid())
  /// 用户ID
  userId            String
  /// 变动类型
  type              TransactionType
  /// 变动金额（正数为增加，负数为减少）
  amount            Int
  /// 变动前余额
  balanceBefore     Int
  /// 变动后余额
  balanceAfter      Int
  /// 变动原因/描述
  description       String          @db.VarChar(500)
  /// 关联的兑奖记录ID（如果是兑奖扣除）
  relatedExchangeId String?         @db.VarChar(100)
  /// 关联的业务ID（如任务ID、活动ID等）
  relatedBusinessId String?         @db.VarChar(100)
  /// 业务类型（如 TASK, ACTIVITY, SIGN_IN 等）
  businessType      String?         @db.VarChar(50)
  /// 创建时间
  createdAt         DateTime        @default(now())
  /// 操作人ID（如管理员手动调整）
  operatorId        String?         @db.VarChar(100)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([businessType])
  @@map("coin_transactions")
}

/// 设置值类型枚举
enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  ARRAY

  @@map("setting_value_type")
}

/// 设置分类枚举
enum SettingCategory {
  SYSTEM
  SECURITY
  NOTIFICATION
  WEDDING
  VENUE
  GUEST
  SCHEDULE
  MAP
  ATTRACTIONS
  CHAT
  ANALYTICS
  UI_UX

  @@map("setting_category")
}

/// 用户角色枚举
enum UserRole {
  ADMIN
  BRIDE
  GROOM
  FAMILY
  FRIEND
  GUEST

  @@map("user_role")
}

/// 兑换状态枚举
enum ExchangeStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REJECTED

  @@map("exchange_status")
}

/// 游戏币交易类型枚举
enum TransactionType {
  EARN
  SPEND
  ADMIN_ADD
  ADMIN_SUB
  REFUND
  SYSTEM

  @@map("transaction_type")
}

/// 景点表
model Attraction {
  /// 景点唯一标识符
  id              String                  @id @default(cuid())
  /// 景点名称
  name            String                  @db.VarChar(200)
  /// 景点描述
  description     String?                 @db.Text
  /// 景点类型（SCENIC景点, FOOD美食, SHOPPING购物, OTHER其他）
  type            AttractionType          @default(OTHER)
  /// 经度（GCJ02坐标系）
  longitude       Float
  /// 纬度（GCJ02坐标系）
  latitude        Float
  /// 解锁距离（米）
  unlockDistance  Int                     @default(100)
  /// 媒体资源（JSON格式存储图片和视频信息）
  media           String?                 @db.Text
  /// 打卡奖励金币数
  rewardCoins     Int                     @default(10)
  /// 是否启用
  isActive        Boolean                 @default(true)
  /// 排序权重
  sortOrder       Int                     @default(0)
  /// 创建时间
  createdAt       DateTime                @default(now())
  /// 更新时间
  updatedAt       DateTime                @updatedAt
  /// 创建者ID
  createdBy       String?                 @db.VarChar(50)
  /// 更新者ID
  updatedBy       String?                 @db.VarChar(50)
  /// 用户打卡记录
  checkIns        UserAttractionCheckIn[]

  @@index([type])
  @@index([isActive])
  @@index([sortOrder])
  @@index([longitude])
  @@index([latitude])
  @@map("attractions")
}

/// 用户景点打卡记录表
model UserAttractionCheckIn {
  /// 记录唯一标识符
  id           String     @id @default(cuid())
  /// 用户ID
  userId       String
  /// 景点ID
  attractionId String
  /// 打卡时间
  checkedInAt  DateTime   @default(now())
  /// 打卡时的距离（米）
  distance     Float?
  /// 本次打卡获得的金币数
  coinsEarned  Int        @default(0)
  /// 打卡时的经度（用户位置）
  longitude    Float?
  /// 打卡时的纬度（用户位置）
  latitude     Float?
  /// 创建时间
  createdAt    DateTime   @default(now())
  /// 更新时间
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attraction   Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@unique([userId, attractionId])
  @@index([userId])
  @@index([attractionId])
  @@index([checkedInAt])
  @@map("user_attraction_check_ins")
}

/// 景点类型枚举
enum AttractionType {
  SCENIC
  FOOD
  SHOPPING
  OTHER

  @@map("attraction_type")
}
