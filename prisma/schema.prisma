// Wedding Explorer Prisma Schema
// 婚礼探索系统数据库模型定义

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

// // ==================== 系统设置表 ====================

/// 系统设置表 - 用于存储系统级别的配置项
model SystemSetting {
  /// 设置项唯一标识符
  id          String           @id @default(cuid())
  /// 设置项键名（唯一）
  key         String           @unique @db.VarChar(100)
  /// 设置项显示名称
  displayName String           @db.VarChar(200)
  /// 设置项值
  value       String?          @db.Text
  /// 设置项类型：string, number, boolean, json, array
  valueType   SettingValueType @default(STRING)
  /// 设置项分类
  category    SettingCategory
  /// 设置项描述
  description String?          @db.Text
  /// 是否为系统内置设置（内置设置不可删除）
  isSystem    Boolean          @default(false)
  /// 是否启用
  isEnabled   Boolean          @default(true)
  /// 排序权重
  sortOrder   Int              @default(0)
  /// 创建时间
  createdAt   DateTime         @default(now())
  /// 更新时间
  updatedAt   DateTime         @updatedAt
  /// 创建者ID
  createdBy   String?          @db.VarChar(50)
  /// 更新者ID
  updatedBy   String?          @db.VarChar(50)

  @@index([category])
  @@index([isEnabled])
  @@index([sortOrder])
  @@map("system_settings")
}

/// 设置值类型枚举
enum SettingValueType {
  STRING // 字符串
  NUMBER // 数字
  BOOLEAN // 布尔值
  JSON // JSON对象
  ARRAY // 数组

  @@map("setting_value_type")
}

/// 设置分类枚举
enum SettingCategory {
  // 基础系统设置
  SYSTEM // 系统基础配置
  SECURITY // 安全相关设置
  NOTIFICATION // 通知设置

  // 婚礼业务设置
  WEDDING // 婚礼基本信息
  VENUE // 场地相关设置
  GUEST // 宾客管理设置
  SCHEDULE // 日程安排设置

  // 功能模块设置
  MAP // 地图探索设置
  CHAT // 对话咨询设置
  ANALYTICS // 分析统计设置
  UI_UX // 界面体验设置

  @@map("setting_category")
}


// ==================== 活动时间线表 ====================
model ActivityTimeline {
  id          String   @id @default(cuid())
  title       String   // 活动标题，例如 "新功能上线"
  description String?  // 活动的详细描述 (可选)

  // --- 关键改动在这里 ---
  // 将 startTime 和 endTime 都设置为可选的 DateTime 类型
  // DateTime 类型本身就支持时分秒的精度
  startTime   DateTime?  // 活动开始时间 (可选)
  endTime     DateTime?  // 活动结束时间 (可选)

  type        String?    // 活动类型 (可选)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== 用户表 ====================

/// 用户信息表
model User {
  /// 用户唯一标识符（自增主键）
  id          Int      @id @default(autoincrement())
  /// 用户邮箱
  email       String?  @db.VarChar(255)
  /// 用户昵称
  nickname    String?  @db.VarChar(100)
  /// 用户真实姓名
  name        String?  @db.VarChar(100)
  /// 用户头像
  avatar      String?  @db.Text
  /// 用户角色
  role        UserRole @default(GUEST)
  /// 是否启用
  isActive    Boolean  @default(true)
  /// 最后登录时间
  lastLoginAt DateTime?
  /// 游戏币余额
  coins       Int      @default(0)
  /// 累计获得游戏币总数
  totalCoinsEarned Int @default(0)
  /// 累计消费游戏币总数
  totalCoinsSpent  Int @default(0)
  /// 创建时间
  createdAt   DateTime @default(now())
  /// 更新时间
  updatedAt   DateTime @updatedAt

  /// 关联的 Authing 认证信息
  authingUser AuthingUser?
  /// 关联的微信认证信息
  wechatUser  WechatUser?
  /// 关联的兑奖记录
  prizeExchanges PrizeExchangeRecord[]
  /// 关联的游戏币流水记录
  coinTransactions CoinTransaction[]

  @@map("users")
  @@index([email])
  @@index([role])
  @@index([coins])
  @@index([totalCoinsEarned])
  @@index([isActive])
}

/// Authing 用户关联表
model AuthingUser {
  /// 主键
  id          Int      @id @default(autoincrement())
  /// 关联的用户 ID
  userId      Int      @unique
  /// Authing 用户 ID
  authingId   String   @unique @db.VarChar(100)
  /// 创建时间
  createdAt   DateTime @default(now())
  /// 更新时间
  updatedAt   DateTime @updatedAt

  /// 关联的用户
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("authing_users")
  @@index([authingId])
  @@index([userId])
}

/// 微信用户关联表
model WechatUser {
  /// 主键
  id          Int      @id @default(autoincrement())
  /// 关联的用户 ID
  userId      Int      @unique
  /// 微信 OpenID
  openId      String   @unique @db.VarChar(100)
  /// 微信 UnionID
  unionId     String?  @unique @db.VarChar(100)
  /// 创建时间
  createdAt   DateTime @default(now())
  /// 更新时间
  updatedAt   DateTime @updatedAt

  /// 关联的用户
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wechat_users")
  @@index([openId])
  @@index([unionId])
  @@index([userId])
}

/// 用户角色枚举
enum UserRole {
  ADMIN    // 管理员
  BRIDE    // 新娘
  GROOM    // 新郎
  FAMILY   // 家属
  FRIEND   // 朋友
  GUEST    // 普通宾客

  @@map("user_role")
}

// ==================== 兑奖记录表 ====================

/// 兑奖记录表
model PrizeExchangeRecord {
  /// 记录唯一标识符
  id          String   @id @default(cuid())
  /// 用户ID
  userId      Int
  /// 用户（外键关联）
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 奖品名称
  prizeName   String   @db.VarChar(200)
  /// 奖品描述
  prizeDesc   String?  @db.Text
  /// 消耗游戏币数量
  coinsSpent  Int
  /// 兑换时用户的游戏币余额（快照）
  userCoinsSnapshot Int
  /// 兑换状态
  status      ExchangeStatus @default(PENDING)
  /// 备注信息（如发货信息、领取方式等）
  remarks     String?  @db.Text
  /// 兑换时间
  exchangedAt DateTime @default(now())
  /// 处理时间（如发货、完成时间）
  processedAt DateTime?
  /// 处理人ID
  processedBy String?  @db.VarChar(100)
  /// 创建时间
  createdAt   DateTime @default(now())
  /// 更新时间
  updatedAt   DateTime @updatedAt

  @@map("prize_exchange_records")
  @@index([userId])
  @@index([status])
  @@index([exchangedAt])
}

/// 兑换状态枚举
enum ExchangeStatus {
  PENDING    // 待处理
  PROCESSING // 处理中
  COMPLETED  // 已完成
  CANCELLED  // 已取消
  REJECTED   // 已拒绝

  @@map("exchange_status")
}

// ==================== 游戏币流水表 ====================

/// 游戏币流水记录表（用于追踪所有游戏币变动）
model CoinTransaction {
  /// 记录唯一标识符
  id          String   @id @default(cuid())
  /// 用户ID
  userId      Int
  /// 用户（外键关联）
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 变动类型
  type        TransactionType
  /// 变动金额（正数为增加，负数为减少）
  amount      Int
  /// 变动前余额
  balanceBefore Int
  /// 变动后余额
  balanceAfter  Int
  /// 变动原因/描述
  description String   @db.VarChar(500)
  /// 关联的兑奖记录ID（如果是兑奖扣除）
  relatedExchangeId String? @db.VarChar(100)
  /// 关联的业务ID（如任务ID、活动ID等）
  relatedBusinessId String? @db.VarChar(100)
  /// 业务类型（如 TASK, ACTIVITY, SIGN_IN 等）
  businessType String?  @db.VarChar(50)
  /// 创建时间
  createdAt   DateTime @default(now())
  /// 操作人ID（如管理员手动调整）
  operatorId  String?  @db.VarChar(100)

  @@map("coin_transactions")
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([businessType])
}

/// 游戏币交易类型枚举
enum TransactionType {
  EARN       // 获得（任务奖励、活动奖励等）
  SPEND      // 消费（兑换奖品）
  ADMIN_ADD  // 管理员增加
  ADMIN_SUB  // 管理员扣除
  REFUND     // 退款
  SYSTEM     // 系统调整

  @@map("transaction_type")
}
