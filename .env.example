# ======== Authing 配置 ========
NEXT_PUBLIC_AUTHING_APP_ID=your_authing_app_id
NEXT_PUBLIC_AUTHING_APP_HOST=https://your-app.authing.cn
AUTHING_APP_SECRET=your_authing_secret

# ======== 管理员用户ID列表，用逗号分隔 ========
AUTHING_ADMIN_ID=admin_user_id_1,admin_user_id_2

# ======== 腾讯云 MySQL 数据库配置 ========
# 格式：mysql://用户名:密码@主机地址:端口/数据库名
# 示例：DATABASE_URL="mysql://root:password@gz-cdb-xxxxx.sql.tencentcdb.com:3306/wedding_explorer"
DATABASE_URL="mysql://username:password@mysql-host:3306/wedding_explorer"

# ======== 分析服务配置（可选） ========
NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
NEXT_PUBLIC_ANALYTICS_SCRIPT_SRC=https://your-analytics-domain.com/js/script.js
NEXT_PUBLIC_ANALYTICS_SITE_ID=your_analytics_site_id
NEXT_PUBLIC_ANALYTICS_TOKEN=your_analytics_token
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_google_analytics_id

# ======== 高德地图配置 ========
NEXT_PUBLIC_AMAP_KEY=your_amap_key
NEXT_PUBLIC_AMAP_SECURITY_KEY=your_amap_security_key

# ======== 腾讯云 CloudBase 配置 ========
CLOUDBASE_ENV_ID=your_env_id
CLOUDBASE_SECRET_ID=your_secret_id
CLOUDBASE_SECRET_KEY=your_secret_key

# ======== 游戏系统配置 ========
# 新用户注册时获得的初始游戏币数量（默认：10）
INITIAL_USER_COINS=10
