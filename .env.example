# Authing 配置
NEXT_PUBLIC_AUTHING_APP_ID=your_authing_app_id
NEXT_PUBLIC_AUTHING_APP_HOST=https://your_authing_domain.authing.cn
AUTHING_APP_SECRET=your_authing_app_secret
# 管理员用户ID列表，用逗号分隔
AUTHING_ADMIN_ID=admin_user_id_1,admin_user_id_2,admin_user_id_3

# 分析服务配置（可选）
NEXT_PUBLIC_ANALYTICS_PROVIDER=your_analytics_provider
NEXT_PUBLIC_ANALYTICS_SCRIPT_SRC=your_analytics_script_src
NEXT_PUBLIC_ANALYTICS_SITE_ID=your_analytics_site_id
NEXT_PUBLIC_ANALYTICS_TOKEN=your_analytics_token
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_google_analytics_id

# 高德地图配置
NEXT_PUBLIC_AMAP_KEY=your_amap_key
NEXT_PUBLIC_AMAP_SECURITY_KEY=your_amap_security_key


# 腾讯（国际版）  cloudaBase API密钥 https://tcb.cloud.tencent.com
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=

# ======== 腾讯 CloudBase 配置 ========
# CloudBase 环境 ID（在 CloudBase 控制台获取）
CLOUDBASE_ENV_ID=your_cloudbase_env_id
# CloudBase 访问密钥 ID（在腾讯云控制台-访问管理-API密钥管理获取）
CLOUDBASE_SECRET_ID=your_cloudbase_secret_id
# CloudBase 访问密钥 Key
CLOUDBASE_SECRET_KEY=your_cloudbase_secret_key

# ======== supabase 配置（已弃用，仅保留用于其他非字典功能） ========
# 注意：数据字典功能已迁移到 CloudBase，以下配置仅用于其他可能依赖 Supabase 的功能
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
POSTGRES_URL=your_postgres_url
POSTGRES_USER=your_postgres_user
POSTGRES_HOST=your_postgres_host
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
POSTGRES_PRISMA_URL=your_postgres_prisma_url
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DATABASE=your_postgres_database
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
POSTGRES_URL_NON_POOLING=your_postgres_url_non_pooling

