# 在 Authing.js 控制台获取的 【App ID】
NEXT_PUBLIC_AUTHING_APP_ID=your_authing_app_id
# 在 Authing.js 控制台获取的【认证地址】
NEXT_PUBLIC_AUTHING_APP_HOST=https://your-authing-app-host.com

# ===== 分析服务配置 =====
# 分析服务提供商 (plausible, fathom, cloudflare, google-analytics, custom)
NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible

# Plausible Analytics 配置， 如果是自己部署的私有服务需要改成自己的资源地址
NEXT_PUBLIC_ANALYTICS_SCRIPT_SRC=https://plausible.io/js/script.js

# Fathom Analytics 配置
NEXT_PUBLIC_ANALYTICS_SITE_ID=your_fathom_site_id

# Cloudflare Web Analytics 配置
NEXT_PUBLIC_ANALYTICS_TOKEN=your_cloudflare_analytics_token

# Google Analytics 4 配置
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ===== 服务端配置 ======
# 在 Authing.js 控制台获取的 【App Secret】（设置需要使用 HS256 对称加密，用于验证 JWT 签名）
AUTHING_APP_SECRET=your_authing_app_secret_here
